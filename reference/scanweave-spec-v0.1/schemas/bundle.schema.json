{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scanweave:schema:bundle:1.0",
  "title": "ScanWeave document bundle v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "asset_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Relative path below the bundle root. Runtime must reject traversal, URI schemes and symlink escapes."
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "image",
              "pdf",
              "multipage_tiff"
            ]
          }
        },
        "required": [
          "source_id",
          "asset_path",
          "file_sha256",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100000
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "source_page_index": {
            "type": "integer",
            "minimum": 0
          },
          "ocr_page_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Relative path below the bundle root. Runtime must reject traversal, URI schemes and symlink escapes."
          },
          "ocr_page_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "page_id",
          "source_id",
          "source_page_index",
          "ocr_page_path",
          "ocr_page_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "sources",
    "pages"
  ],
  "additionalProperties": false
}
