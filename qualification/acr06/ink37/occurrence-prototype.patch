+
+/// Evidence for using the legacy page-wide colours to paint visible text.
+/// Segmentation deliberately remains unchanged: a failed check retains the
+/// source raster instead of rebuilding ownership with a different threshold.
+pub(crate) fn supported_page_colours(
+    rgb: &[u8],
+    width: usize,
+    height: usize,
+    paper: [u8; 3],
+    ink: [u8; 3],
+) -> bool {
+    if width == 0 || height == 0 || rgb.len() != width * height * 3 {
+        return false;
+    }
+    let (x0, x1) = (width / 10, width - width / 10);
+    let (y0, y1) = (height / 10, height - height / 10);
+    let mut histogram = [0usize; 32];
+    let mut ink_samples = 0usize;
+    let mut count = 0usize;
+    for y in (y0..y1).step_by(4) {
+        for x in (x0..x1).step_by(4) {
+            let i = (y * width + x) * 3;
+            let p = [rgb[i], rgb[i + 1], rgb[i + 2]];
+            let l = lum(p);
+            histogram[(l as usize / 8).min(31)] += 1;
+            if (0..3).all(|c| (p[c] as i16 - ink[c] as i16).abs() <= 30) {
+                ink_samples += 1;
+            }
+            count += 1;
+        }
+    }
+    let Some((bin, &mode_count)) = histogram.iter().enumerate().max_by_key(|(_, n)| *n) else {
+        return false;
+    };
+    let mode_lum = bin as f64 * 8.0 + 4.0;
+    count > 0
+        && mode_count * 10 >= count
+        && ink_samples * 1000 >= count
+        && (mode_lum - lum(paper)).abs() <= 35.0
+        && (lum(ink) - lum(paper)).abs() >= 30.0
+}
+
+/// An ink colour indistinguishable from the local mode is not evidence of
+/// text colour. Check only final vector candidates; ambiguous pages stay raster.
+pub(crate) fn supported_local_ink(
+    rgb: &[u8],
+    width: usize,
+    height: usize,
+    bbox: [f64; 4],
+    ink: [u8; 3],
+) -> bool {
+    if width == 0
+        || height == 0
+        || rgb.len() != width * height * 3
+        || bbox.iter().any(|x| !x.is_finite())
+    {
+        return false;
+    }
+    let x0 = (bbox[0].floor() as isize - 3).clamp(0, width as isize) as usize;
+    let y0 = (bbox[1].floor() as isize - 3).clamp(0, height as isize) as usize;
+    let x1 = (bbox[2].ceil() as isize + 3).clamp(0, width as isize) as usize;
+    let y1 = (bbox[3].ceil() as isize + 3).clamp(0, height as isize) as usize;
+    if x0 >= x1 || y0 >= y1 {
+        return false;
+    }
+    let mut histogram = [0usize; 256];
+    let mut matched = 0usize;
+    for y in y0..y1 {
+        for x in x0..x1 {
+            let i = (y * width + x) * 3;
+            let p = [rgb[i], rgb[i + 1], rgb[i + 2]];
+            histogram[(lum(p) as usize).min(255)] += 1;
+            if (0..3).all(|c| (p[c] as i16 - ink[c] as i16).abs() <= 30) { matched += 1; }
+        }
+    }
+    let mode = (0usize..256)
+        .max_by_key(|&i| {
+            let lo = i.saturating_sub(4);
+            let hi = (i + 5).min(256);
+            histogram[lo..hi].iter().sum::<usize>()
+        })
+        .unwrap_or(0);
+    matched >= 2 && matched * 50 >= (x1 - x0) * (y1 - y0)
+        && (lum(ink) - mode as f64).abs() >= 15.0
+}
+
+#[cfg(test)]
+mod colour_evidence_tests {
+    use super::{supported_local_ink, supported_page_colours};
+
+    fn page(paper: [u8; 3], ink: [u8; 3]) -> Vec<u8> {
+        let mut rgb = vec![0; 100 * 100 * 3];
+        for y in 0..100 {
+            for x in 0..100 {
+                let c = if (40..60).contains(&x) && (40..60).contains(&y) { ink } else { paper };
+                rgb[(y * 100 + x) * 3..(y * 100 + x + 1) * 3].copy_from_slice(&c);
+            }
+        }
+        rgb
+    }
+
+    #[test]
+    fn dark_border_does_not_support_inverted_estimates() {
+        let rgb = page([230, 216, 180], [40, 30, 20]);
+        assert!(!supported_page_colours(&rgb, 100, 100, [10, 10, 10], [230, 216, 180]));
+    }
+
+    #[test]
+    fn true_reverse_and_coloured_paper_can_be_supported() {
+        let rgb = page([30, 30, 30], [235, 235, 235]);
+        assert!(supported_page_colours(&rgb, 100, 100, [30, 30, 30], [235, 235, 235]));
+        let rgb = page([245, 225, 130], [85, 50, 30]);
+        assert!(supported_page_colours(&rgb, 100, 100, [245, 225, 130], [85, 50, 30]));
+    }
+
+    #[test]
+    fn ambiguous_page_and_local_paper_colour_fall_back() {
+        let rgb = page([200, 200, 200], [195, 195, 195]);
+        assert!(!supported_page_colours(&rgb, 100, 100, [200, 200, 200], [195, 195, 195]));
+        assert!(!supported_local_ink(&rgb, 100, 100, [40.0, 40.0, 60.0, 60.0], [200, 200, 200]));
+    }
+}
