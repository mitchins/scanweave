 fn glyph_ink_iou_contract(
+    g: &GlyphShape, crop_w: usize, crop_h: usize, mask: &[bool], clearscan: bool,
+) -> f64 {
+    if crop_w == 0 || crop_h == 0 { return 1.0; }
+    let cover = glyph_coverage_contract(g, crop_w, crop_h, clearscan);
+    const SUB: usize = 4;
+    // Foreground at at least half a pixel of covered area.
+    let fill: Vec<bool> = cover
+        .iter()
+        .map(|c| {
+            *c >= if clearscan {
+                0.5
+            } else {
+                SUB.div_ceil(2) as f64
+            }
+        })
+        .collect();
+    let mut inter = 0usize;
+    let mut uni = 0usize;
+    for (i, m) in mask.iter().enumerate() {
+        if i >= fill.len() {
+            break;
+        }
+        if *m || fill[i] {
+            uni += 1;
+            if *m && fill[i] {
+                inter += 1;
+            }
+        }
+    }
+    if uni == 0 {
+        1.0
+    } else {
+        inter as f64 / uni as f64
+    }
+}
